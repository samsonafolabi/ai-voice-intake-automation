        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-20b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an HVAC dispatch assistant. Given a transcript from a customer or technician, classify it and respond with ONLY valid JSON, no markdown, no explanation. Format: {\\\"urgency\\\": \\\"emergency\\\" or \\\"routine\\\", \\\"issue_type\\\": string, \\\"equipment\\\": string, \\\"summary\\\": string (one sentence)}. Emergency = no heat, no cooling, gas smell, water leak/flooding, electrical hazard. Routine = maintenance, quotes, non-urgent repairs.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.text }}\"\n    }\n  ],\n  \"temperature\": 0.2\n}",
